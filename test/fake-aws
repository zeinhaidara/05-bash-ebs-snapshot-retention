#!/usr/bin/env bash
# Fake aws CLI: prints canned output and logs every call to $FAKE_LOG.
echo "$*" >> "${FAKE_LOG:?}"
args=" $* "
case $4 in
  describe-volumes)
    printf 'vol-running\ti-running\nvol-stopped\ti-stopped\n' ;;
  describe-instances)
    case $args in
      *i-stopped*) echo stopped ;;
      *) echo running ;;
    esac ;;
  create-snapshot) echo snap-new ;;
  describe-snapshots)
    printf 'snap-old\t2020-01-01T00:00:00+00:00\n'
    printf 'snap-recent\t2999-01-01T00:00:00+00:00\n'
    # without the tag filter the fake also returns a foreign old snapshot
    case $args in
      *tag:created-by*) ;;
      *) printf 'snap-foreign\t2020-01-01T00:00:00+00:00\n' ;;
    esac ;;
  delete-snapshot) ;;
  *) echo "fake-aws: unexpected call: $*" >&2; exit 1 ;;
esac
